---
const path = Astro.url.pathname;
const REPO = 'ItWasYou-SAM/AI-INFERENCE-ENGINEERING-FROM-SCRATCH';
const links = [
  { href: '/roadmap', label: 'Roadmap' },
  { href: '/learn/m00/what-is-inference-engineering', label: 'Start', match: '/learn' },
  { href: '/sources', label: 'Sources' },
];
---

<header
  class="sticky top-0 z-50 border-b border-dashed border-rule bg-paper/85 backdrop-blur-md"
>
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-5">
    <a href="/" class="group flex items-center gap-2.5" aria-label="Home">
      <img
        src="/logo-128.png"
        alt=""
        width="36"
        height="36"
        class="h-9 w-9 transition-transform duration-700 ease-out group-hover:rotate-180 dark:invert"
      />
      <span class="font-display text-lg leading-none">
        Inference<span class="text-ink-faint">/</span><span class="italic">from scratch</span>
      </span>
    </a>
    <div class="flex items-center gap-1 sm:gap-3">
      {
        links.map((l) => {
          const active = path.startsWith(l.match ?? l.href);
          return (
            <a
              href={l.href}
              class:list={[
                'rounded-md px-2.5 py-1 font-mono text-xs tracking-wide uppercase transition-colors',
                active ? 'bg-paper-3 text-ink' : 'text-ink-soft hover:text-ink',
              ]}
            >
              {l.label}
            </a>
          );
        })
      }
      <a
        href={`https://github.com/${REPO}`}
        target="_blank"
        rel="noopener"
        data-gh-repo={REPO}
        class="ml-1 flex h-8 items-center overflow-hidden rounded-full border border-rule font-mono text-xs text-ink-soft transition-colors hover:border-ink hover:text-ink"
        aria-label="Star this course on GitHub"
      >
        <span class="flex items-center gap-1.5 px-2.5">
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
          </svg>
          <span class="hidden sm:inline">GitHub</span>
        </span>
        <span class="flex h-full items-center gap-1 border-l border-rule bg-paper-3 px-2.5 text-ink">
          <svg class="h-3.5 w-3.5 text-amber" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25z"></path>
          </svg>
          <span data-gh-stars>Star</span>
        </span>
      </a>
      <button
        id="theme-toggle"
        type="button"
        class="ml-1 grid h-8 w-8 place-items-center rounded-full border border-rule text-ink-soft transition hover:rotate-12 hover:text-ink"
        aria-label="Toggle dark mode"
      >
        <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
        <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  // Live star count from the public GitHub API, cached for the session (unauthenticated limit: 60 requests/hour per IP).
  const fmtStars = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}k` : String(n));
  async function loadStars() {
    const link = document.querySelector<HTMLElement>('[data-gh-repo]');
    const out = link?.querySelector<HTMLElement>('[data-gh-stars]');
    if (!link || !out) return;
    const repo = link.dataset.ghRepo!;
    const key = `gh-stars:${repo}`;
    let stars = sessionStorage.getItem(key);
    if (stars === null) {
      try {
        const res = await fetch(`https://api.github.com/repos/${repo}`, { headers: { Accept: 'application/vnd.github+json' } });
        if (!res.ok) return; // keep the "Star" label
        stars = String((await res.json()).stargazers_count);
        sessionStorage.setItem(key, stars);
      } catch {
        return;
      }
    }
    out.textContent = fmtStars(Number(stars));
    link.setAttribute('aria-label', `Star this course on GitHub (${stars} stars)`);
  }
  document.addEventListener('astro:page-load', loadStars);

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('#theme-toggle');
    if (!btn) return;
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
    window.dispatchEvent(new CustomEvent('themechange', { detail: next }));
  });
</script>
