---
const path = Astro.url.pathname;
const links = [
  { href: '/roadmap', label: 'Roadmap' },
  { href: '/learn/m00/what-is-inference-engineering', label: 'Start', match: '/learn' },
  { href: '/sources', label: 'Sources' },
];
---

<header
  class="sticky top-0 z-50 border-b border-dashed border-rule bg-paper/85 backdrop-blur-md"
>
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-5">
    <a href="/" class="group flex items-center gap-2.5" aria-label="Home">
      <img
        src="/logo-128.png"
        alt=""
        width="36"
        height="36"
        class="h-9 w-9 transition-transform duration-700 ease-out group-hover:rotate-180 dark:invert"
      />
      <span class="font-display text-lg leading-none">
        Inference<span class="text-ink-faint">/</span><span class="italic">from scratch</span>
      </span>
    </a>
    <div class="flex items-center gap-1 sm:gap-3">
      {
        links.map((l) => {
          const active = path.startsWith(l.match ?? l.href);
          return (
            <a
              href={l.href}
              class:list={[
                'rounded-md px-2.5 py-1 font-mono text-xs tracking-wide uppercase transition-colors',
                active ? 'bg-paper-3 text-ink' : 'text-ink-soft hover:text-ink',
              ]}
            >
              {l.label}
            </a>
          );
        })
      }
      <button
        id="theme-toggle"
        type="button"
        class="ml-1 grid h-8 w-8 place-items-center rounded-full border border-rule text-ink-soft transition hover:rotate-12 hover:text-ink"
        aria-label="Toggle dark mode"
      >
        <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
        <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('#theme-toggle');
    if (!btn) return;
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
    window.dispatchEvent(new CustomEvent('themechange', { detail: next }));
  });
</script>
