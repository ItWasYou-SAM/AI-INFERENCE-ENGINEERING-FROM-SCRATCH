---
import { sources, type SourceId } from '../../data/sources';
interface Props {
  id: SourceId;
  note?: string;
  href?: string;
}
const { id, note, href } = Astro.props;
const s = sources[id];
const url = href ?? s.url;
const kindGlyph = { repo: '⌥', course: '❖', blog: '✎', paper: '§', book: '❡', post: '✳' }[s.kind];
const Tag = url ? 'a' : 'div';
---

<Tag
  href={url}
  target={url ? '_blank' : undefined}
  rel={url ? 'noopener' : undefined}
  class="sheet group flex gap-3 p-4 no-underline transition-transform duration-300 hover:-translate-y-0.5 hover:-rotate-[0.4deg]"
>
  <span class="font-display text-2xl leading-none text-blue" aria-hidden="true">{kindGlyph}</span>
  <span class="min-w-0">
    <span class="eyebrow block">{s.kind} · {s.id}{s.placeholder ? ' · placeholder' : ''}</span>
    <span class="block font-display text-base leading-snug text-ink group-hover:underline">{s.title}</span>
    <span class="block text-xs text-ink-soft">{s.author}</span>
    {note && <span class="mt-1.5 block text-sm text-ink-soft">{note}</span>}
  </span>
</Tag>
