---
import BaseLayout from '../layouts/BaseLayout.astro';
import SourceCard from '../components/ui/SourceCard.astro';
import { sources } from '../data/sources';
import { allModules } from '../data/roadmap';

const usedBy = (id: string) => allModules.filter((m) => m.sources.some((s) => s.id === id));
---

<BaseLayout title="Sources" description="The open-source repos, courses, blogs, papers and books this curriculum is built on.">
  <section class="mx-auto max-w-4xl px-5 pt-14">
    <p class="eyebrow">Built on the shoulders of</p>
    <h1 class="mt-2 text-5xl">Sources</h1>
    <p class="mt-5 max-w-2xl text-lg text-ink-soft">
      Every chapter credits the material it draws on and links back to it. These are the primary sources, with the modules that use each one.
    </p>
    <div class="mt-12 space-y-8">
      {
        Object.values(sources).map((s) => (
          <div class="grid gap-4 sm:grid-cols-[18rem_1fr]">
            <SourceCard id={s.id} />
            <div>
              <p class="text-[0.95rem] leading-relaxed">{s.description}</p>
              <div class="mt-3 flex flex-wrap gap-1.5">
                {usedBy(s.id).map((m) => (
                  <a href={`/learn/${m.id}/${m.chapters[0].slug}`} class="rounded border border-rule px-1.5 py-0.5 font-mono text-[0.65rem] text-ink-soft hover:text-ink">
                    {m.id === 'capstone' ? 'Capstone' : `M${m.num}`} · {m.title}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
